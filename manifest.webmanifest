{
  "name": "DukanList — Every Shop, One App",
  "short_name": "DukanList",
  "description": "Bharat's local business directory — 82 categories, verified shopkeepers, free registration.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#FF6B1A",
  "background_color": "#FFFBF5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "/assets/icons/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Categories",
      "short_name": "Browse",
      "url": "/browse.html",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Search Shops",
      "short_name": "Search",
      "url": "/search.html",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Register Your Shop",
      "short_name": "Register",
      "url": "/register.html",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
